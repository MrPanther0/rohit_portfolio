# ─────────────────────────────────────────────────────────────
# Shared / Docker Compose
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=portfolio

# ─────────────────────────────────────────────────────────────
# API  (apps/api/.env)
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://portfolio:change-me-in-production@localhost:5432/portfolio?schema=public

# 64+ random chars each. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_REFRESH_REMEMBER_TTL_DAYS=90

# Bootstrap admin created by `npm run db:seed`
ADMIN_EMAIL=admin@studio.dev
ADMIN_PASSWORD=ChangeMe!2024
ADMIN_NAME=Studio Admin

# local | cloudinary
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# Optional — enables response caching + refresh-token denylist across instances
REDIS_URL=

LOG_LEVEL=info
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─────────────────────────────────────────────────────────────
# WEB  (apps/web/.env.local)
# ─────────────────────────────────────────────────────────────
# Server-side fetches (inside Docker use http://api:4000)
API_INTERNAL_URL=http://localhost:4000
# Browser-side fetches (admin panel, analytics beacons, contact form)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
