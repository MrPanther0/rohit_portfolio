{
  "name": "aurum-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Immersive dark-luxury portfolio experience with a full content management backend.",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "start": "concurrently -n api,web -c magenta,cyan \"npm:start:api\" \"npm:start:web\"",
    "start:web": "npm run start --workspace apps/web",
    "start:api": "npm run start --workspace apps/api",
    "lint": "npm run lint --workspace apps/web && npm run lint --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/web && npm run typecheck --workspace apps/api",
    "db:generate": "npm run prisma:generate --workspace apps/api",
    "db:migrate": "npm run prisma:migrate --workspace apps/api",
    "db:push": "npm run prisma:push --workspace apps/api",
    "db:seed": "npm run prisma:seed --workspace apps/api",
    "db:studio": "npm run prisma:studio --workspace apps/api",
    "setup": "npm install && npm run db:generate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
